# Browser play and Blender exports work with WORKSHOP_PROVIDER=off.
WORKSHOP_PROVIDER=off
# For image generation over a compatible API, set the provider and these values.
WORKSHOP_AI_BASE_URL=
WORKSHOP_AI_MODEL=
WORKSHOP_AI_API_KEY=
WORKSHOP_AI_JSON_MODE=schema
# Set a strong access token for a shared installation.
WORKSHOP_ACCESS_TOKEN=

# For an HTTPS reverse proxy, use the public URL without a trailing slash.
WORKSHOP_ORIGIN=
